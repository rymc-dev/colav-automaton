flowchart TD
    A([Start: heading_within_tolerance_guard]) --> B{len(continuous_state) == 5?}
    B -->|No| Z1[/Raise ValueError/]
    B -->|Yes| C{"'waypoints' in ctx.auxiliary_states?"}
    C -->|No| Z2[/Raise ValueError/]
    C -->|Yes| D[waypoint = ctx.auxiliary_states'waypoints'.latest]
    D --> E{waypoint is None?}
    E -->|Yes| Z3[/Raise ValueError/]
    E -->|No| F{ctx.configuration is a dict?}
    F -->|No| Z4[/Raise ValueError/]
    F -->|Yes| G["xx, xy, yaw = continuous_state[0:3]<br/>wx, wy = waypoint"]
    G --> H{agent position == waypoint?}
    H -->|Yes| I([Return False])
    H -->|No| J["desired = atan2(wy - xy, wx - xx)"]
    J --> K["error = normalize(desired - yaw) to [-pi, pi]"]
    K --> L{"abs(error) < heading_tolerance_off?"}
    L -->|Yes| M([Return True])
    L -->|No| N([Return False])
